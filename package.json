{
  "name": "youtube-automation-agent",
  "version": "2.11.0",
  "description": "YouTube Automation Agent is an open-source AI agent that runs a YouTube channel end to end",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "postinstall": "playwright install chromium",
    "setup": "node setup.js",
    "walkthrough": "node walkthrough.js",
    "growth:snapshot": "node scripts/growth/snapshot-github.js",
    "docs:screenshots": "node scripts/docs/capture-screenshots.js",
    "scheduler": "node schedules/daily-automation.js",
    "test": "node test.js && node --test tests/subscription-text.test.js tests/cursor-subscription.test.js tests/walkthrough-chatgpt.test.js tests/image-providers.test.js tests/research-subscription.test.js tests/research-provenance.test.js tests/research-service.test.js tests/scene-timing.test.js",
    "agent:strategy": "node agents/content-strategy-agent.js",
    "agent:script": "node agents/script-writer-agent.js",
    "agent:thumbnail": "node agents/thumbnail-designer-agent.js",
    "agent:seo": "node agents/seo-optimizer-agent.js",
    "agent:production": "node agents/production-management-agent.js",
    "agent:publishing": "node agents/publishing-scheduling-agent.js",
    "agent:analytics": "node agents/analytics-optimization-agent.js",
    "credentials:setup": "node utils/credential-manager.js setup",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google/genai": "^2.9.0",
    "axios": "^1.7.0",
    "chalk": "^4.1.2",
    "cross-spawn": "^7.0.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.4",
    "googleapis": "^173.0.0",
    "inquirer": "^8.2.6",
    "microsoft-cognitiveservices-speech-sdk": "^1.45.0",
    "moment": "^2.29.4",
    "node-cron": "^4.6.0",
    "openai": "^6.0.0",
    "playwright": "^1.54.2",
    "replicate": "^1.4.0",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1",
    "winston": "^3.11.0"
  },
  "optionalDependencies": {
    "@cursor/sdk": "^1.2.0",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
